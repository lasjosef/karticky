{
  "name": "Tip Cards",
  "short_name": "Tip Cards",
  "description": "Lines and tips worth remembering. Swipe cards, get one in your notifications, synced through your own Google Drive.",
  "lang": "en",
  "id": "./",
  "start_url": "./#today",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#eef0f3",
  "theme_color": "#eef0f3",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "Add a card", "url": "./#add", "icons": [{"src": "icon-192.png", "sizes": "192x192"}]}
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {"title": "title", "text": "text", "url": "url"}
  }
}
